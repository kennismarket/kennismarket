# MODELO de configuração. Este arquivo vai para o GitHub, então NUNCA coloque chaves aqui.
# No computador: copie para um arquivo chamado ".env" (que o GitHub ignora) e preencha lá.
# No Render (ou na Hostinger): cadastre estes mesmos nomes nas variáveis de ambiente do painel.

PORT=3000

# ---------- Supabase ----------
# Endereço do projeto. Painel do Supabase → botão "Connect" (topo) ou Project Settings → Data API.
# Ex.: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Chave PÚBLICA (começa com sb_publishable_). Project Settings → API Keys → "Publishable key".
# Pode aparecer no navegador, isso é normal.
SUPABASE_PUBLISHABLE_KEY=

# Chave SECRETA (começa com sb_secret_). Project Settings → API Keys → "Secret keys".
# Dá acesso total ao banco. Só no .env e no painel da hospedagem. Nunca no GitHub, nunca no chat.
SUPABASE_SECRET_KEY=

# ---------- Pagamentos ----------
# Qual banco usar: "simulado" (testes, sem dinheiro, com a página /teste/pagamentos) ou "transfeera".
# Fique no "simulado" até o provedor da Transfeera estar pronto (falta a documentação da API).
PAYMENT_PROVIDER=simulado
# Cartão de crédito ainda não confirmado: deixe "false".
PAYMENT_CARD_ENABLED=false

# ---------- Transfeera ----------
# "sandbox" (testes) ou "producao" (dinheiro de verdade: só com autorização dos donos).
TRANSFEERA_AMBIENTE=sandbox
# ⚠️ NOMES PROVISÓRIOS: confirmar na documentação da Transfeera quais credenciais ela usa.
TRANSFEERA_CLIENT_ID=
TRANSFEERA_CLIENT_SECRET=
# Segredo para conferir que o aviso de pagamento (webhook) veio mesmo da Transfeera.
TRANSFEERA_WEBHOOK_SECRET=

# ---------- IA do chat de suporte (opcional) ----------
# Chave da API da Anthropic (console.anthropic.com → API Keys). Tem custo por uso.
# Vazia = o suporte do site responde "fora do ar, mande um e-mail", como o protótipo faz.
ANTHROPIC_API_KEY=

# ---------- Tarefas agendadas ----------
# Uma senha inventada (longa). Cadastre a MESMA no GitHub → Settings → Secrets and variables
# → Actions → Secrets → TAREFAS_TOKEN. É o que deixa o GitHub disparar a atualização das cotações.
TAREFAS_TOKEN=

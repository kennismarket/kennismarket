# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub.
# Na Hostinger, estes mesmos nomes são cadastrados no painel (variáveis de ambiente).

PORT=3000

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave secreta: só no servidor, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Asaas: deixe "sandbox" até os donos autorizarem dinheiro real.
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=
# Token que o Asaas envia junto com os avisos de pagamento (webhook).
ASAAS_WEBHOOK_TOKEN=

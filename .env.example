# MODELO de configuração. Este arquivo vai para o GitHub, então NUNCA coloque chaves aqui.
# No computador: copie para um arquivo chamado ".env" (que o GitHub ignora) e preencha lá.
# No Render (ou na Hostinger): cadastre estes mesmos nomes nas variáveis de ambiente do painel.

PORT=3000

# ---------- Supabase ----------
# Endereço do projeto. Painel do Supabase → botão "Connect" (topo) ou Project Settings → Data API.
# Ex.: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Chave PÚBLICA (começa com sb_publishable_). Project Settings → API Keys → "Publishable key".
# Pode aparecer no navegador, isso é normal.
SUPABASE_PUBLISHABLE_KEY=

# Chave SECRETA (começa com sb_secret_). Project Settings → API Keys → "Secret keys".
# Dá acesso total ao banco. Só no .env e no painel da hospedagem. Nunca no GitHub, nunca no chat.
SUPABASE_SECRET_KEY=

# ---------- Asaas ----------
# Deixe "sandbox" até os donos autorizarem dinheiro real.
ASAAS_AMBIENTE=sandbox
# Asaas (sandbox.asaas.com) → Integrações → Chave de API.
ASAAS_API_KEY=
# Uma senha inventada por vocês (longa). Cadastre a MESMA no Asaas → Integrações → Webhooks
# → "Token de autenticação". Assim o site sabe que o aviso de pagamento veio mesmo do Asaas.
ASAAS_WEBHOOK_TOKEN=

# ---------- Tarefas agendadas ----------
# Outra senha inventada (longa). Cadastre a MESMA no GitHub → Settings → Secrets and variables
# → Actions → Secrets → TAREFAS_TOKEN. É o que deixa o GitHub disparar cotações e repasses.
TAREFAS_TOKEN=

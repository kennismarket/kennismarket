# MODELO de configuração. Este arquivo vai para o GitHub, então NUNCA coloque chaves aqui.
# No computador: copie para um arquivo chamado ".env" (que o GitHub ignora) e preencha lá.
# Na Hostinger: cadastre estes mesmos nomes nas variáveis de ambiente do painel.

PORT=3000

# ---------- Supabase ----------
# Endereço do projeto. Painel do Supabase → botão "Connect" (topo) ou Project Settings → Data API.
# Ex.: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Chave PÚBLICA (começa com sb_publishable_). Project Settings → API Keys → "Publishable key".
# Pode aparecer no navegador, isso é normal.
SUPABASE_PUBLISHABLE_KEY=

# Chave SECRETA (começa com sb_secret_). Project Settings → API Keys → "Secret keys".
# Dá acesso total ao banco. Só no .env e na Hostinger. Nunca no GitHub, nunca no chat.
SUPABASE_SECRET_KEY=

# ---------- Asaas (etapa 3) ----------
# Deixe "sandbox" até os donos autorizarem dinheiro real.
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
